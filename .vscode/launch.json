{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Address Book",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/addressbook",
            "windows": {
                "program": "${workspaceFolder}/addressbook.exe"
            },
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build Address Book",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
