{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Address Book",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/Contact.cpp",
                "${workspaceFolder}/src/AddressBook.cpp",
                "-o",
                "${workspaceFolder}/addressbook"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Compiles all source files. Works on Linux, Mac, and Windows (with MinGW/MSYS2)."
        }
    ]
}
